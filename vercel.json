{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "functions": {
    "app.mjs": {
      "includeFiles": "public/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/utmify",
      "schedule": "0 6 * * *"
    }
  ]
}
